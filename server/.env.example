# Backend Environment Configuration
APP_NAME=Pocket Ledger
NODE_ENV=development
PORT=5000

# Frontend origins allowed by CORS (Comma-separated: production frontend URL and localhost)
CLIENT_ORIGIN=https://expense.spkumarchalla.com,http://localhost:5173

# MongoDB Connection String (MongoDB Atlas URI)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pocket_ledger?retryWrites=true&w=majority

# Sessions & Security
SESSION_SECRET=replace_with_a_secure_random_string_min_32_chars
SESSION_MAX_AGE_MS=604800000

# Cookie settings for cross-site deployment (Render <-> Vercel)
COOKIE_SAME_SITE=none
COOKIE_SECURE=true

# Admin & Registration
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ALLOW_PUBLIC_REGISTRATION=true
