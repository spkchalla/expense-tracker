# Pocket Ledger Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# NEVER commit the real .env file with secrets to version control.

# Application
APP_NAME=Pocket Ledger
NODE_ENV=development
PORT=5000

# Backend CORS Allowed Origins (Comma-separated for multiple origins)
# In production on Render, set: https://expense.spkumarchalla.com
CLIENT_ORIGIN=https://expense.spkumarchalla.com,http://localhost:5173

# Database Connection
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pocket_ledger?retryWrites=true&w=majority

# Authentication & Sessions
SESSION_SECRET=replace_with_a_secure_random_string_min_32_chars
SESSION_MAX_AGE_MS=604800000

# Cookie Settings for Cross-Site Production (Vercel <-> Render)
# Set COOKIE_SAME_SITE=none and COOKIE_SECURE=true when frontend and backend are on different domains
COOKIE_SAME_SITE=none
COOKIE_SECURE=true

# Administration & Feature Flags
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ALLOW_PUBLIC_REGISTRATION=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=15

# Frontend Environment Variables (for Vercel or client/.env.production)
# Optional: Defaults to https://expense-tracker-ia0u.onrender.com/api in production
# VITE_API_BASE_URL=https://expense-tracker-ia0u.onrender.com/api
