# Pocket Ledger Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# NEVER commit the real .env file with secrets to version control.

# Application
APP_NAME=Pocket Ledger
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database Connection
# MongoDB connection string (e.g. mongodb+srv://<user>:<password>@cluster.mongodb.net/pocket_ledger?retryWrites=true&w=majority)
MONGODB_URI=mongodb://localhost:27017/pocket_ledger

# Authentication & Sessions
SESSION_SECRET=replace_with_a_secure_random_string_min_32_chars
SESSION_MAX_AGE_MS=604800000
COOKIE_SECURE=false

# Administration & Feature Flags
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ALLOW_PUBLIC_REGISTRATION=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
